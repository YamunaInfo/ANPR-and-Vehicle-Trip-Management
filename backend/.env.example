# ANPRX Edge ANPR and Trip Management - Environment Configuration

# Database Configuration (MySQL 8.x)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=anprx_app
MYSQL_PASSWORD=YOUR_SECURE_PASSWORD
MYSQL_DATABASE=anprx

# SQLAlchemy Database Connection URL
# Note: Special characters in password must be URL encoded (e.g. '@' -> '%40', '!' -> '%21')
DATABASE_URL=mysql+pymysql://anprx_app:YOUR_SECURE_PASSWORD@localhost:3306/anprx

# Server Configuration
PORT=5001
HOST=0.0.0.0
ENVIRONMENT=production

# OCR & AI Configuration
OCR_ENGINE=PaddleOCR
USE_GPU=True
CONFIDENCE_THRESHOLD=0.75

# Deduplication Settings
DEDUPLICATION_WINDOW_SECONDS=15
